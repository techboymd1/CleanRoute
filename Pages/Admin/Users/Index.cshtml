@page
@model CleanRoute.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}
<div class="heading-row">
    <div>
        <p class="eyebrow">USER MANAGEMENT</p>
        <h1>People using CleanRoute</h1>
        <p>Residents, collection staff, and administrators.</p>
    </div>
</div>
<section class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Phone</th>
                    <th>Account status</th>
                </tr>
            </thead>
            <tbody>@foreach (var user in Model.Users) {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>@user.PhoneNumber</td>
                    <td><span class="status @(user.IsActive ? "collected" : "cancelled")">@(user.IsActive ? "Active" :
                                    "Inactive")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>