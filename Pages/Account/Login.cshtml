@page
@model CleanRoute.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="auth-card">
    <p class="eyebrow">CLEANER STREETS, SIMPLER COLLECTIONS</p>
    <h1>Welcome back</h1>
    <p>Sign in to request a pickup or manage collections.</p>
    @if (TempData["Success"] is string message)
    {
        <div class="notice success">@message</div>
    }
    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label>Email<input asp-for="Input.Email" autocomplete="email" /></label>
        <label>Password<input asp-for="Input.Password" type="password" autocomplete="current-password" /></label>
        <button class="button" type="submit">Sign in</button>
    </form>
    <p class="hint">New here? <a asp-page="Register">Create a resident account</a>.</p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
`