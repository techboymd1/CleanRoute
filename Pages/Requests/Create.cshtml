@page
@model CleanRoute.Pages.Requests.CreateModel
@{
    ViewData["Title"] = "New collection request";
}
<div class="heading-row">
    <div>
        <p class="eyebrow">NEW REQUEST</p>
        <h1>Book a waste collection</h1>
        <p>Tell us what needs collecting and when you would prefer us to visit.</p>
    </div>
</div>
<section class="panel form-panel">
    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label>Waste type<select asp-for="Input.WasteType"
                                     asp-items="Html.GetEnumSelectList<WasteType>()"></select></label>
            <label>Collection address<input asp-for="Input.CollectionAddress" /><span
                asp-validation-for="Input.CollectionAddress" class="validation"></span></label>
                <label>Preferred collection date<input asp-for="Input.PreferredDate" type="date" /><span
                    asp-validation-for="Input.PreferredDate" class="validation"></span></label>
                    <label>Extra notes <span class="muted">(optional)</span><textarea asp-for="Input.Notes" rows="4"
                                                                                          placeholder="Gate instructions, quantity, or landmark"></textarea></label>
                        <div class="action-row"><a class="button button-secondary" asp-page="Index">Cancel</a><button class="button"
                                                                                                                          type="submit">Submit request</button></div>
                        </form>
                    </section>
                    @section Scripts {
                        <partial name="_ValidationScriptsPartial" />
                    }